# Relay environment configuration
# Copy this file to .env and fill in values. .env is gitignored — never commit real secrets.
#
# IMPORTANT: Relay defaults to deterministic, offline mock mode when LLM_PROVIDER
# is unset or set to "mock". No provider SDK or network call is made in mock mode.
# Set LLM_PROVIDER to a real provider only when you want to use a live model.

# Provider selection: unset | mock | openai | anthropic | azure
# Leave unset or set to "mock" for fully offline, deterministic operation.
LLM_PROVIDER=mock

# Required only when LLM_PROVIDER points at a real provider.
# Never commit this file with real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Optional model overrides when using a real provider.
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Optional: directory for generated SQLite DBs, traces, reports (defaults to relay/state)
RELAY_STATE_DIR=relay/state
